{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algites:modustro:builder:yamldef:model:technology-kind-definition:1",
  "x-algites-definition-version": 1,
  "title": "Modustro Builder TechnologyKind Definition v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "DocumentContent": {
      "type": "object",
      "properties": {
        "TechnologyKind": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
        },
        "Capabilities": {
          "type": "array",
          "items": {
            "$ref": "urn:algites:modustro:builder:yamldef:model:capability-definition:1#EmbeddedContent"
          }
        },
        "BuildOutputTypes": {
          "type": "array",
          "items": {
            "$ref": "urn:algites:modustro:builder:yamldef:model:build-output-type-definition:1#EmbeddedContent"
          }
        },
        "DefaultBuildOutputTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "DefaultDependencyOutputTypes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "TechnologyKind",
        "Capabilities",
        "BuildOutputTypes",
        "DefaultBuildOutputTypes",
        "DefaultDependencyOutputTypes"
      ]
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": false
}
