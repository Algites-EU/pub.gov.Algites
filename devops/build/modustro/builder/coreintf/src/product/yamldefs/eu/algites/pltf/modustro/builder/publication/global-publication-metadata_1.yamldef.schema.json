{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algites:modustro:builder:yamldef:publication:global-publication-metadata:1",
  "x-algites-definition-version": 1,
  "title": "Modustro Global Publication Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "MetadataVersion": {
      "const": 1
    },
    "DefinitionVersion": {
      "type": "integer",
      "minimum": 1
    },
    "GlobalPublicationPathId": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$"
    }
  },
  "required": [
    "MetadataVersion",
    "DefinitionVersion",
    "GlobalPublicationPathId"
  ]
}
