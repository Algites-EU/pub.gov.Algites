        ]
      },
      "then": {
        "properties": {
          "Minimum": {
            "type": "null"
          },
          "Maximum": {
            "type": "null"
          },
          "MaximumStrict": {
            "type": "null"
          },
          "Exclude": {
            "type": "null"
          },
          "Prefer": {
            "type": "null"
          }
        }
      }
