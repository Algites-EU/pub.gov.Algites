{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algites:modustro:builder:yamldef:capability-configuration:java:generation-of-native-documentation:1",
  "x-algites-definition-version": 1,
  "title": "Java Native Documentation Capability Configuration v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "DocumentContent": {
      "type": "object",
      "properties": {
        "Enabled": {
          "type": "boolean",
          "default": true
        },
        "Javadoc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "MemberVisibility": {
              "type": "string",
              "enum": [
                "public",
                "protected",
                "package",
                "private"
              ],
              "default": "protected"
            },
            "Encoding": {
              "type": "string",
              "minLength": 1
            },
            "DocumentEncoding": {
              "type": "string",
              "minLength": 1
            },
            "Charset": {
              "type": "string",
              "minLength": 1
            },
            "WindowTitle": {
              "type": "string"
            },
            "DocumentTitle": {
              "type": "string"
            },
            "AdditionalArguments": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": false
}
