{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algites:modustro:builder:model:technology-kinds:1",
  "x-algites-definition-version": 1,
  "title": "Modustro Builder TechnologyKinds Configuration v1",
  "$defs": {
    "BuildOutputTypeItem": {
      "type": "object",
