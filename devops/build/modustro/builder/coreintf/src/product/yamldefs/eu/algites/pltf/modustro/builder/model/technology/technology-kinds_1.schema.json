    "CapabilityItem": {
      "type": "object",
      "properties": {
        "Capability": {
          "type": "string",
          "minLength": 1
        },
        "Enabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "Capability"
      ],
      "additionalProperties": true
    },
    "TechnologyKindItem": {
      "type": "object",
      "properties": {
        "TechnologyKind": {
          "type": "string",
          "minLength": 1
        },
        "BuildOutputTypes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "mergeMissingItems",
                "removeMissingItems"
