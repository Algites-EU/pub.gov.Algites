              "default": "mergeMissingItems"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/BuildOutputTypeItem"
              }
            }
          },
          "required": [
            "Items"
          ]
        },
        "Capabilities": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "mergeMissingItems",
                "removeMissingItems"
              ],
              "default": "mergeMissingItems"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CapabilityItem"
              }
            }
          },
          "required": [
            "Items"
          ]
        }
      },
      "required": [
        "TechnologyKind"
      ],
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ItemsInheritancePolicy": {
          "type": "string",
          "enum": [
