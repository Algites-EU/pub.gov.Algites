                "Inclusive"
              ]
            }
          ]
        },
        "Maximum": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:(?:<=|<)[^<>=!\\s]+|[^<>=!\\s]+(?:>=|>))$"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "Version": {
                  "type": "string",
                  "minLength": 1
                },
                "Inclusive": {
                  "type": "boolean"
                }
