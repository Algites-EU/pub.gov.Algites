  "$id": "urn:algites:modustro:builder:jsondef:model:version-requirement:1",
  "x-algites-definition-version": 1,
  "title": "Modustro Builder Version Requirement v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
