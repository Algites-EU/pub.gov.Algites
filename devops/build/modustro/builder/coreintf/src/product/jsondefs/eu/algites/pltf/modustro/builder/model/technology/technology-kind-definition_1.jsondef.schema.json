{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algites:modustro:builder:jsondef:model:technology-kind-definition:1",
  "x-algites-definition-version": 1,
  "title": "Modustro Builder TechnologyKind Definition v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "TechnologyKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "Capabilities": {
      "type": "array",
      "items": {
        "$ref": "urn:algites:modustro:builder:jsondef:model:capability-definition:1"
      }
    },
    "BuildOutputTypes": {
      "type": "array",
      "items": {
        "$ref": "urn:algites:modustro:builder:jsondef:model:build-output-type-definition:1"
      }
    },
    "DefaultBuildOutputTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "DefaultDependencyOutputTypes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "TechnologyKind",
    "Capabilities",
    "BuildOutputTypes",
    "DefaultBuildOutputTypes",
    "DefaultDependencyOutputTypes"
  ]
}
