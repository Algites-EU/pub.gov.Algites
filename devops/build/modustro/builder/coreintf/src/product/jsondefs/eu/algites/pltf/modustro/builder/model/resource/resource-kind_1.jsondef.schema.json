{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:algites:modustro:builder:jsondef:model:resource:resource-kind:1",
  "x-algites-definition-version": 1,
  "title": "ResourceKind Definition v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ResourceKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "TechnologyKinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "Actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "download",
          "upload",
          "manage"
        ]
      }
    },
    "StabilityRequirement": {
      "type": "string",
      "enum": [
        "required",
        "optional",
        "forbidden"
      ]
    }
  },
  "required": [
    "ResourceKind",
    "TechnologyKinds",
    "Actions",
    "StabilityRequirement"
  ]
}
