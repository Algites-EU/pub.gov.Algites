<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:algites:modustro:builder:model:version-requirement:1" targetNamespace="urn:algites:modustro:builder:model:version-requirement:1" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Defines exact, bounded, excluded, and preferred versions used by Modustro Builder dependency resolution.</xs:documentation>
    <xs:appinfo>
      <DefinitionVersion>1</DefinitionVersion>
      <Note>Exact is mutually exclusive with non-null Minimum, Maximum, MaximumStrict, Exclude, and Prefer in one source declaration; inheritance may retain ignored preferences for diagnostics.</Note>
    </xs:appinfo>
  </xs:annotation>
  <xs:complexType name="VersionBoundType">
    <xs:annotation>
      <xs:documentation>Defines one version boundary together with whether the boundary itself is included.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Version" type="xs:string">
        <xs:annotation>
          <xs:documentation>Version value represented by this entry.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Inclusive" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Whether the associated minimum or maximum boundary includes the specified version.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ExcludeType">
    <xs:annotation>
      <xs:documentation>Represents a collection of explicitly excluded versions.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Item" type="xs:string" minOccurs="0" maxOccurs="unbounded">
        <xs:annotation>
          <xs:documentation>One explicitly excluded version.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="ItemsInheritancePolicy" type="xs:string" default="merge_missing_items">
      <xs:annotation>
        <xs:documentation>Controls how excluded versions are inherited when requirements are overlaid.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="VersionRequirement">
    <xs:annotation>
      <xs:documentation>Root version-requirement document.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Exact" type="xs:string" minOccurs="0" nillable="true">
          <xs:annotation>
            <xs:documentation>Requires exactly the specified version.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Minimum" type="VersionBoundType" minOccurs="0" nillable="true">
          <xs:annotation>
            <xs:documentation>Sets the minimum allowed version, optionally inclusive.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Maximum" type="VersionBoundType" minOccurs="0" nillable="true">
          <xs:annotation>
            <xs:documentation>Sets a non-strict maximum version that may be relaxed by phased dependency resolution.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="MaximumStrict" type="xs:boolean" minOccurs="0" nillable="true">
          <xs:annotation>
            <xs:documentation>Sets a strict maximum version that must not be exceeded.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Exclude" type="ExcludeType" minOccurs="0" nillable="true">
          <xs:annotation>
            <xs:documentation>Lists versions that must not be selected.</xs:documentation>
          </xs:annotation>
        </xs:element>
        <xs:element name="Prefer" type="xs:string" minOccurs="0" nillable="true">
          <xs:annotation>
            <xs:documentation>Specifies a preferred version to try before falling back to the allowed range.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
