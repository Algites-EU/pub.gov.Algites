<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Selects whether an endpoint belongs to the public or private resource namespace.</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="ResourceEndpointVisibilityType">
    <xs:annotation>
      <xs:documentation>Selects whether an endpoint belongs to the public or private resource namespace.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="public">
        <xs:annotation>
          <xs:documentation>Endpoint is intended for public resources and does not require private-resource semantics.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="private">
        <xs:annotation>
          <xs:documentation>Endpoint is intended for private resources and may require authenticated access.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
