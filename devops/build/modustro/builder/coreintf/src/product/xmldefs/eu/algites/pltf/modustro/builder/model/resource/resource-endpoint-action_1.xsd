<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Selects the operation performed through a resource endpoint.</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="ResourceEndpointActionType">
    <xs:annotation>
      <xs:documentation>Selects the operation performed through a resource endpoint.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="download">
        <xs:annotation>
          <xs:documentation>Reads or resolves resources from the endpoint.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="upload">
        <xs:annotation>
          <xs:documentation>Publishes resources to the endpoint.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="manage">
        <xs:annotation>
          <xs:documentation>Performs management operations on endpoint content, such as cleanup or deletion.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
