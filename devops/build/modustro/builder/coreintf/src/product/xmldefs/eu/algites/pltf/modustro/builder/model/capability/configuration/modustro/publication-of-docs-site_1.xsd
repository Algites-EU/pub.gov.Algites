<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Configures publication of the assembled Modustro documentation site.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Documentation-site publication capability configuration.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Enabled" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Whether documentation-site publication is enabled.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="PublicationDestinations" minOccurs="0" maxOccurs="1" type="xs:anyType">
        <xs:annotation>
          <xs:documentation>ResourceEndpoint identifiers selected as publication destinations for the documentation site.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="CapabilityConfiguration" type="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Root documentation-site publication capability configuration.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>
