<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Selects release or snapshot stability for resource kinds that use a stability dimension.</xs:documentation>
  </xs:annotation>
  <xs:simpleType name="ResourceStabilityType">
    <xs:annotation>
      <xs:documentation>Selects release or snapshot stability for resource kinds that use a stability dimension.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="release">
        <xs:annotation>
          <xs:documentation>Stable released resource intended to be immutable under the release policy.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="snapshot">
        <xs:annotation>
          <xs:documentation>Mutable development snapshot resource that may be replaced by newer snapshot content.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
</xs:schema>
