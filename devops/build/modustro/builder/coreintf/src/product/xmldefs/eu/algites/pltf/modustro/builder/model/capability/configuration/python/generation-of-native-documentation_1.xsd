<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Configures generation of native Python documentation for an artifact.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Python native-documentation capability configuration.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Enabled" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Whether native Python documentation generation is enabled.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Sphinx" minOccurs="0" maxOccurs="1" type="xs:anyType">
        <xs:annotation>
          <xs:documentation>Sphinx-specific configuration passed to the Python native-documentation generator.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="CapabilityConfiguration" type="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Root Python native-documentation capability configuration.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>
