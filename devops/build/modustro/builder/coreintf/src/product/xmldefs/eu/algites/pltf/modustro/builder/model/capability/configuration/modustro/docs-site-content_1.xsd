<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Configures whether an artifact contributes content to the Modustro documentation site.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Documentation-site content capability configuration.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Enabled" minOccurs="0" maxOccurs="1" type="xs:boolean">
        <xs:annotation>
          <xs:documentation>Whether this artifact contributes content to the documentation site.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="CapabilityConfiguration" type="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Root documentation-site content capability configuration.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>
