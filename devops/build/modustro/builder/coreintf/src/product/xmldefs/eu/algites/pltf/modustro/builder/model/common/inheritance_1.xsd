<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="urn:algites:modustro:builder:model:inheritance:1" targetNamespace="urn:algites:modustro:builder:model:inheritance:1" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Defines the generic inheritance controls used when child configuration overlays collections inherited from a parent scope.</xs:documentation>
    <xs:appinfo>
      <DefinitionVersion>1</DefinitionVersion>
    </xs:appinfo>
  </xs:annotation>
  <xs:simpleType name="ItemsInheritancePolicyType">
    <xs:annotation>
      <xs:documentation>Selects how collection items missing from the child declaration are handled during inheritance.</xs:documentation>
    </xs:annotation>
    <xs:restriction base="xs:string">
      <xs:enumeration value="merge_missing_items">
        <xs:annotation>
          <xs:documentation>Keeps parent items that are not redefined by the child and merges child changes over them.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
      <xs:enumeration value="remove_missing_items">
        <xs:annotation>
          <xs:documentation>Removes parent items that are not explicitly present in the child declaration.</xs:documentation>
        </xs:annotation>
      </xs:enumeration>
    </xs:restriction>
  </xs:simpleType>
  <xs:complexType name="StringItemsCollectionType">
    <xs:annotation>
      <xs:documentation>Represents a string collection with an explicit item-inheritance policy.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="Items" minOccurs="0" maxOccurs="unbounded" type="xs:string">
        <xs:annotation>
          <xs:documentation>Collection item value participating in inheritance.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
    <xs:attribute name="ItemsInheritancePolicy" type="ItemsInheritancePolicyType" default="merge_missing_items">
      <xs:annotation>
        <xs:documentation>Controls whether items missing from the child declaration remain inherited or are removed.</xs:documentation>
      </xs:annotation>
    </xs:attribute>
  </xs:complexType>
  <xs:element name="Inheritance">
    <xs:annotation>
      <xs:documentation>Root document describing inheritance settings.</xs:documentation>
    </xs:annotation>
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Items" minOccurs="0" maxOccurs="unbounded" type="xs:anyType">
          <xs:annotation>
            <xs:documentation>Collection item value participating in inheritance.</xs:documentation>
          </xs:annotation>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="ItemsInheritancePolicy" type="ItemsInheritancePolicyType" default="merge_missing_items">
        <xs:annotation>
          <xs:documentation>Controls whether items missing from the child declaration remain inherited or are removed.</xs:documentation>
        </xs:annotation>
      </xs:attribute>
    </xs:complexType>
  </xs:element>
</xs:schema>
