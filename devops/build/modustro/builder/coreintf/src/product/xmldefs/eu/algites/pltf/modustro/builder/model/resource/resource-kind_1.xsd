<?xml version='1.0' encoding='UTF-8'?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>Defines a ResourceKind and the TechnologyKinds, actions, and stability semantics applicable to resources of that kind.</xs:documentation>
  </xs:annotation>
  <xs:complexType name="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Canonical declaration of one ResourceKind.</xs:documentation>
    </xs:annotation>
    <xs:sequence>
      <xs:element name="ResourceKind" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation>Stable identifier of the resource kind.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="TechnologyKinds" minOccurs="1" maxOccurs="1" type="xs:anyType">
        <xs:annotation>
          <xs:documentation>TechnologyKinds that may use or provide this resource kind.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="Actions" minOccurs="1" maxOccurs="1" type="xs:anyType">
        <xs:annotation>
          <xs:documentation>ResourceEndpoint actions supported for this resource kind.</xs:documentation>
        </xs:annotation>
      </xs:element>
      <xs:element name="StabilityRequirement" minOccurs="1" maxOccurs="1" type="xs:string">
        <xs:annotation>
          <xs:documentation>Whether endpoints of this resource kind require, permit, or forbid the stability dimension.</xs:documentation>
        </xs:annotation>
      </xs:element>
    </xs:sequence>
  </xs:complexType>
  <xs:element name="ResourceModel" type="DocumentContentType">
    <xs:annotation>
      <xs:documentation>Root ResourceKind definition document.</xs:documentation>
    </xs:annotation>
  </xs:element>
</xs:schema>
