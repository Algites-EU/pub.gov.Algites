{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-dependencies_1.schema.json",
  "title": "Algites Dependencies v1",
  "$defs": {
    "Usages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "product_api",
          "product_implementation",
          "product_compile_only",
          "product_compile_only_api",
          "product_runtime_only",
          "product_annotation_processor",
          "develop_implementation",
          "develop_compile_only",
          "develop_runtime_only",
          "develop_annotation_processor"
        ]
      }
    },
    "RequiredBuildOutputTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
      }
    },
    "ModustroDependencyItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GroupId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "ArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "VariantId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Usages": {
          "$ref": "#/$defs/Usages"
        },
        "RequiredBuildOutputTypes": {
          "$ref": "#/$defs/RequiredBuildOutputTypes"
        },
        "VersionRequirement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "algites-version-requirement_1.schema.json"
            }
          ]
        }
      },
      "required": [
        "ArtifactId"
      ]
    },
    "ModustroDependencyConstraintItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GroupId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "ArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "VariantId": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Usages": {
          "$ref": "#/$defs/Usages"
        },
        "VersionRequirement": {
          "$ref": "algites-version-requirement_1.schema.json"
        }
      },
      "required": [
        "ArtifactId",
        "VersionRequirement"
      ]
    },
    "JavaDependencyItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GroupId": {
          "type": "string",
          "minLength": 1
        },
        "ArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "Usages": {
          "$ref": "#/$defs/Usages"
        },
        "VersionRequirement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "algites-version-requirement_1.schema.json"
            }
          ]
        }
      },
      "required": [
        "ArtifactId",
        "GroupId"
      ]
    },
    "JavaDependencyConstraintItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "GroupId": {
          "type": "string",
          "minLength": 1
        },
        "ArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "Usages": {
          "$ref": "#/$defs/Usages"
        },
        "VersionRequirement": {
          "$ref": "algites-version-requirement_1.schema.json"
        }
      },
      "required": [
        "ArtifactId",
        "GroupId",
        "VersionRequirement"
      ]
    },
    "PythonDependencyItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "Usages": {
          "$ref": "#/$defs/Usages"
        },
        "VersionRequirement": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "algites-version-requirement_1.schema.json"
            }
          ]
        }
      },
      "required": [
        "ArtifactId"
      ]
    },
    "PythonDependencyConstraintItem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "Usages": {
          "$ref": "#/$defs/Usages"
        },
        "VersionRequirement": {
          "$ref": "algites-version-requirement_1.schema.json"
        }
      },
      "required": [
        "ArtifactId",
        "VersionRequirement"
      ]
    },
    "DependencyGroup": {
      "type": "object",
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "properties": {
            "DependencyKind": {
              "const": "modustro"
            },
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "merge_missing_items",
                "remove_missing_items"
              ],
              "default": "merge_missing_items"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ModustroDependencyItem"
              }
            }
          },
          "required": [
            "DependencyKind",
            "Items"
          ]
        },
        {
          "properties": {
            "DependencyKind": {
              "const": "java"
            },
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "merge_missing_items",
                "remove_missing_items"
              ],
              "default": "merge_missing_items"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/JavaDependencyItem"
              }
            }
          },
          "required": [
            "DependencyKind",
            "Items"
          ]
        },
        {
          "properties": {
            "DependencyKind": {
              "const": "python"
            },
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "merge_missing_items",
                "remove_missing_items"
              ],
              "default": "merge_missing_items"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PythonDependencyItem"
              }
            }
          },
          "required": [
            "DependencyKind",
            "Items"
          ]
        }
      ]
    },
    "DependencyConstraintGroup": {
      "type": "object",
      "unevaluatedProperties": false,
      "oneOf": [
        {
          "properties": {
            "DependencyKind": {
              "const": "modustro"
            },
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "merge_missing_items",
                "remove_missing_items"
              ],
              "default": "merge_missing_items"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ModustroDependencyConstraintItem"
              }
            }
          },
          "required": [
            "DependencyKind",
            "Items"
          ]
        },
        {
          "properties": {
            "DependencyKind": {
              "const": "java"
            },
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "merge_missing_items",
                "remove_missing_items"
              ],
              "default": "merge_missing_items"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/JavaDependencyConstraintItem"
              }
            }
          },
          "required": [
            "DependencyKind",
            "Items"
          ]
        },
        {
          "properties": {
            "DependencyKind": {
              "const": "python"
            },
            "ItemsInheritancePolicy": {
              "type": "string",
              "enum": [
                "merge_missing_items",
                "remove_missing_items"
              ],
              "default": "merge_missing_items"
            },
            "Items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/PythonDependencyConstraintItem"
              }
            }
          },
          "required": [
            "DependencyKind",
            "Items"
          ]
        }
      ]
    },
    "Dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DependencyGroup"
      }
    },
    "DependencyConstraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DependencyConstraintGroup"
      }
    }
  }
}
