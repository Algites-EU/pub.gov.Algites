{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-version_1.schema.json",
  "title": "Algites Version v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Lane": {
      "type": "string",
      "minLength": 1
    },
    "ReleaseLine": {
      "type": "string",
      "minLength": 1
    },
    "Revision": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      ]
    },
    "QualifierKind": {
      "type": "string",
      "enum": [
        "snapshot"
      ]
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "Lane"
          ]
        },
        {
          "required": [
            "ReleaseLine"
          ]
        }
      ]
    }
  ]
}
