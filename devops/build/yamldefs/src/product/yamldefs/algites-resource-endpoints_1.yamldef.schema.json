{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-resource-endpoints_1.yamldef.schema.json",
  "title": "Algites ResourceEndpoints v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "stableResourceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "pattern": "^algites-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "CredentialProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Enabled": {
          "type": "boolean"
        },
        "ResourceEndpointProviderAdapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Stability": {
          "type": "string",
          "enum": [
            "release",
            "snapshot"
          ],
          "description": "Release/snapshot stability. It may be omitted by an inherited amendment but is required on the effective endpoint for ResourceKinds that use stability channels."
        }
      },
      "required": [
        "Id"
      ],
      "minProperties": 2
    },
    "unstableResourceEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "pattern": "^algites-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "CredentialProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Enabled": {
          "type": "boolean"
        },
        "ResourceEndpointProviderAdapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "Id"
      ],
      "minProperties": 1
    },
    "stableResourceEndpointList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/stableResourceEndpoint"
      }
    },
    "unstableResourceEndpointList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unstableResourceEndpoint"
      }
    },
    "stableActionMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download": {
          "$ref": "#/$defs/stableResourceEndpointList"
        },
        "upload": {
          "$ref": "#/$defs/stableResourceEndpointList"
        },
        "manage": {
          "$ref": "#/$defs/stableResourceEndpointList"
        }
      },
      "minProperties": 1
    },
    "unstableActionMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download": {
          "$ref": "#/$defs/unstableResourceEndpointList"
        },
        "upload": {
          "$ref": "#/$defs/unstableResourceEndpointList"
        },
        "manage": {
          "$ref": "#/$defs/unstableResourceEndpointList"
        }
      },
      "minProperties": 1
    },
    "stableVisibilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {
          "$ref": "#/$defs/stableActionMatrix"
        },
        "private": {
          "$ref": "#/$defs/stableActionMatrix"
        }
      },
      "minProperties": 1
    },
    "unstableVisibilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {
          "$ref": "#/$defs/unstableActionMatrix"
        },
        "private": {
          "$ref": "#/$defs/unstableActionMatrix"
        }
      },
      "minProperties": 1
    },
    "modustroResourceKinds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_site": {
          "$ref": "#/$defs/unstableVisibilityMatrix"
        },
        "modustro_docs_site": {
          "$ref": "#/$defs/stableVisibilityMatrix"
        }
      },
      "minProperties": 1
    },
    "DocumentContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "java": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "OutputSelector": {
                "type": "string",
                "enum": [
                  "native_product_sources",
                  "native_product_binaries",
                  "native_product_documentation",
                  "native_develop_sources",
                  "native_develop_binaries",
                  "native_develop_documentation",
                  "native_outputs",
                  "native_product_outputs",
                  "native_develop_outputs",
                  "native_sources",
                  "native_binaries",
                  "native_documentation"
                ]
              },
              "Enabled": {
                "type": "boolean"
              },
              "public": {
                "$ref": "#/$defs/stableActionMatrix"
              },
              "private": {
                "$ref": "#/$defs/stableActionMatrix"
              }
            },
            "required": [
              "OutputSelector"
            ]
          }
        },
        "python": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "OutputSelector": {
                "type": "string",
                "enum": [
                  "native_product_sources",
                  "native_product_binaries",
                  "native_product_documentation",
                  "native_develop_sources",
                  "native_develop_binaries",
                  "native_develop_documentation",
                  "native_outputs",
                  "native_product_outputs",
                  "native_develop_outputs",
                  "native_sources",
                  "native_binaries",
                  "native_documentation"
                ]
              },
              "Enabled": {
                "type": "boolean"
              },
              "public": {
                "$ref": "#/$defs/stableActionMatrix"
              },
              "private": {
                "$ref": "#/$defs/stableActionMatrix"
              }
            },
            "required": [
              "OutputSelector"
            ]
          }
        },
        "mps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "OutputSelector": {
                "type": "string",
                "enum": [
                  "native_product_sources",
                  "native_product_binaries",
                  "native_product_documentation",
                  "native_develop_sources",
                  "native_develop_binaries",
                  "native_develop_documentation",
                  "native_outputs",
                  "native_product_outputs",
                  "native_develop_outputs",
                  "native_sources",
                  "native_binaries",
                  "native_documentation"
                ]
              },
              "Enabled": {
                "type": "boolean"
              },
              "public": {
                "$ref": "#/$defs/stableActionMatrix"
              },
              "private": {
                "$ref": "#/$defs/stableActionMatrix"
              }
            },
            "required": [
              "OutputSelector"
            ]
          }
        },
        "modustro": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "OutputSelector": {
                "type": "string",
                "enum": [
                  "modustro_docs_site",
                  "schema_site"
                ]
              },
              "Enabled": {
                "type": "boolean"
              },
              "public": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/stableActionMatrix"
                  },
                  {
                    "$ref": "#/$defs/unstableActionMatrix"
                  }
                ]
              },
              "private": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/stableActionMatrix"
                  },
                  {
                    "$ref": "#/$defs/unstableActionMatrix"
                  }
                ]
              }
            },
            "required": [
              "OutputSelector"
            ],
            "allOf": [
              {
                "if": {
                  "properties": {
                    "OutputSelector": {
                      "const": "schema_site"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "public": {
                      "$ref": "#/$defs/unstableActionMatrix"
                    },
                    "private": {
                      "$ref": "#/$defs/unstableActionMatrix"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "public": {
                      "$ref": "#/$defs/stableActionMatrix"
                    },
                    "private": {
                      "$ref": "#/$defs/stableActionMatrix"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "minProperties": 1
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": false
    },
    "nativeOutputResourceKinds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native_product_binaries": {
          "$ref": "#/$defs/stableVisibilityMatrix"
        },
        "native_product_sources": {
          "$ref": "#/$defs/stableVisibilityMatrix"
        },
        "native_product_documentation": {
          "$ref": "#/$defs/stableVisibilityMatrix"
        }
      },
      "minProperties": 1
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": false
}
