{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-credential-profiles_1.schema.json",
  "title": "Algites Credential Profiles v1",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/credentialProfile"
  },
  "$defs": {
    "credentialProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["basic", "bearer", "api-key", "client-certificate"]
        },
        "configuration": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      },
      "minProperties": 1
    }
  }
}
