{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-artifact_1.schema.json",
  "title": "Algites Artifact Definition v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "technologyKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "java",
              "python",
              "mps"
            ]
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "repositories": {
          "$ref": "algites-repository-matrix_1.schema.json"
        },
        "versionContext": {
          "$ref": "algites-version-context_1.schema.json"
        }
      },
      "required": [
        "technologyKinds"
      ]
    },
    "groupId": {
      "type": "string",
      "minLength": 1
    },
    "versionContext": {
      "$ref": "algites-version-context_1.schema.json"
    },
    "credentialProfiles": {
      "$ref": "algites-credential-profiles_1.schema.json"
    },
    "deleteSnapshotWhenReleased": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "artifact"
  ]
}
