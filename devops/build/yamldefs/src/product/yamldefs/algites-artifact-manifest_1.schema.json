{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-artifact-manifest_1.schema.json",
  "title": "Algites Artifact Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifestVersion": {
      "const": 1
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repositoryId": {
          "type": "string",
          "minLength": 1
        },
        "localArtifactId": {
          "type": "string",
          "minLength": 1
        },
        "artifactCoordinateId": {
          "type": "string",
          "minLength": 1
        },
        "groupId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1
        },
        "structureKind": {
          "type": "string",
          "enum": [
            "artifact-set",
            "artifact"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "repositoryId",
        "localArtifactId",
        "artifactCoordinateId",
        "version",
        "sourcePath",
        "structureKind",
        "name",
        "description"
      ]
    },
    "sourceMetadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "descriptorHierarchy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "structureKind": {
                "type": "string",
                "enum": [
                  "repository",
                  "artifact-set",
                  "artifact"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "structureKind",
              "path",
              "sha256"
            ]
          }
        }
      },
      "required": [
        "descriptorHierarchy"
      ]
    }
  },
  "required": [
    "manifestVersion",
    "artifact",
    "sourceMetadata"
  ]
}
