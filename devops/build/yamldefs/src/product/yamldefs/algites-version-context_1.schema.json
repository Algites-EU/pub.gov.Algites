{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-version-context_1.schema.json",
  "title": "Algites Version Context v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "lane": { "type": "string", "minLength": 1 },
    "releaseLine": { "type": "string", "minLength": 1 },
    "revision": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "pattern": "^[0-9]+$" }
      ]
    },
    "qualifierKind": {
      "type": "string",
      "enum": ["SNAPSHOT", "PRE_RELEASE", "RELEASE", "FINAL", "POST_RELEASE"]
    },
    "qualifierLabel": { "type": "string" }
  },
  "allOf": [
    {
      "anyOf": [
        { "required": ["lane"] },
        { "required": ["releaseLine"] }
      ]
    }
  ]
}
