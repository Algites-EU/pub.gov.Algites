{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-credentials_1.schema.json",
  "title": "Algites Credentials v1",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/profileValues"
  },
  "$defs": {
    "profileValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Basic": {
          "$ref": "#/$defs/basicCredential"
        },
        "Bearer": {
          "$ref": "#/$defs/bearerCredential"
        },
        "ApiKey": {
          "$ref": "#/$defs/apiKeyCredential"
        },
        "Certificate": {
          "$ref": "#/$defs/certificateCredential"
        }
      },
      "minProperties": 1
    },
    "basicCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Username": {
          "$ref": "#/$defs/valueSource"
        },
        "Password": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "Username",
        "Password"
      ]
    },
    "bearerCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Token": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "Token"
      ]
    },
    "apiKeyCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ApiKey": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "ApiKey"
      ]
    },
    "certificateCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Certificate": {
          "$ref": "#/$defs/valueSource"
        },
        "PrivateKey": {
          "$ref": "#/$defs/valueSource"
        },
        "PrivateKeyPassword": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "Certificate"
      ]
    },
    "valueSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/directValue"
        },
        {
          "$ref": "#/$defs/fileContent"
        },
        {
          "$ref": "#/$defs/secretContent"
        },
        {
          "$ref": "#/$defs/environmentVariableContent"
        }
      ]
    },
    "directValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Source": {
          "const": "direct_value"
        },
        "Value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Source",
        "Value"
      ]
    },
    "fileContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Source": {
          "const": "file_content"
        },
        "Value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Source",
        "Value"
      ]
    },
    "secretContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Source": {
          "const": "secret_content"
        },
        "Value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Source",
        "Value"
      ]
    },
    "environmentVariableContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Source": {
          "const": "environment_variable_content"
        },
        "Value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "Source",
        "Value"
      ]
    }
  }
}
