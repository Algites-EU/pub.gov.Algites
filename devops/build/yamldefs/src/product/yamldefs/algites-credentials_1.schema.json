{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-credentials_1.schema.json",
  "title": "Algites Credentials v1",
  "type": "object",
  "propertyNames": {
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
  },
  "additionalProperties": {
    "$ref": "#/$defs/profileValues"
  },
  "$defs": {
    "profileValues": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "basic": {
          "$ref": "#/$defs/basicCredential"
        },
        "bearer": {
          "$ref": "#/$defs/bearerCredential"
        },
        "api-key": {
          "$ref": "#/$defs/apiKeyCredential"
        },
        "certificate": {
          "$ref": "#/$defs/certificateCredential"
        }
      },
      "minProperties": 1
    },
    "basicCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "$ref": "#/$defs/valueSource"
        },
        "password": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "bearerCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "token"
      ]
    },
    "apiKeyCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apiKey": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "apiKey"
      ]
    },
    "certificateCredential": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "certificate": {
          "$ref": "#/$defs/valueSource"
        },
        "privateKey": {
          "$ref": "#/$defs/valueSource"
        },
        "privateKeyPassword": {
          "$ref": "#/$defs/valueSource"
        }
      },
      "required": [
        "certificate"
      ]
    },
    "valueSource": {
      "oneOf": [
        {
          "$ref": "#/$defs/directValue"
        },
        {
          "$ref": "#/$defs/fileContent"
        },
        {
          "$ref": "#/$defs/secretContent"
        },
        {
          "$ref": "#/$defs/environmentVariableContent"
        }
      ]
    },
    "directValue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "DIRECT_VALUE"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "value"
      ]
    },
    "fileContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "FILE_CONTENT"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "value"
      ]
    },
    "secretContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "SECRET_CONTENT"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "value"
      ]
    },
    "environmentVariableContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "ENVIRONMENT_VARIABLE_CONTENT"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "source",
        "value"
      ]
    }
  }
}
