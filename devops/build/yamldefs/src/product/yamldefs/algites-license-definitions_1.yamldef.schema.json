{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-license-definitions_1.yamldef.schema.json",
  "title": "Algites License Definitions v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "DocumentContent": {
      "type": "object",
      "properties": {
        "Licenses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "Id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9.+-]+$"
              },
              "Name": {
                "type": "string",
                "minLength": 1
              },
              "Url": {
                "type": "string",
                "format": "uri"
              },
              "Text": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "Id",
              "Name",
              "Text"
            ]
          }
        }
      },
      "required": [
        "Licenses"
      ]
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": false
}
