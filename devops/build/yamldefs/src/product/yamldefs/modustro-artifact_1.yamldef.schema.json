{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/modustro-artifact_1.yamldef.schema.json",
  "title": "Modustro Artifact Definition v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "DocumentContent": {
      "type": "object",
      "properties": {
        "Artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "TechnologyKinds": {
              "oneOf": [
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "java",
                      "python",
                      "mps",
                      "modustro"
                    ]
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ItemsInheritancePolicy": {
                      "type": "string",
                      "enum": [
                        "merge_missing_items",
                        "remove_missing_items"
                      ],
                      "default": "merge_missing_items"
                    },
                    "Items": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "TechnologyKind": {
                            "type": "string",
                            "enum": [
                              "java",
                              "python",
                              "mps",
                              "modustro"
                            ]
                          },
                          "BuildOutputTypes": {
                            "oneOf": [
                              {
                                "type": "array",
                                "uniqueItems": true,
                                "items": {
                                  "type": "string",
                                  "minLength": 1
                                }
                              },
                              {
                                "type": "object",
                                "additionalProperties": false,
                                "properties": {
                                  "ItemsInheritancePolicy": {
                                    "type": "string",
                                    "enum": [
                                      "merge_missing_items",
                                      "remove_missing_items"
                                    ],
                                    "default": "merge_missing_items"
                                  },
                                  "Items": {
                                    "type": "array",
                                    "items": {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "BuildOutputType": {
                                          "type": "string",
                                          "minLength": 1
                                        }
                                      },
                                      "required": [
                                        "BuildOutputType"
                                      ]
                                    }
                                  }
                                },
                                "required": [
                                  "Items"
                                ]
                              }
                            ]
                          }
                        },
                        "required": [
                          "TechnologyKind"
                        ]
                      }
                    }
                  },
                  "required": [
                    "Items"
                  ]
                }
              ]
            },
            "Name": {
              "type": "string",
              "minLength": 1
            },
            "Description": {
              "type": "string"
            },
            "ResourceEndpoints": {
              "$ref": "algites-resource-endpoints_1.yamldef.schema.json#EmbeddedContent"
            },
            "Version": {
              "$ref": "algites-version_1.yamldef.schema.json"
            },
            "VariantId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "TechnologyKinds"
          ]
        },
        "GroupId": {
          "type": "string",
          "minLength": 1
        },
        "Version": {
          "$ref": "algites-version_1.yamldef.schema.json"
        },
        "CredentialProfiles": {
          "$ref": "algites-credential-profiles_1.yamldef.schema.json#EmbeddedContent"
        },
        "Dependencies": {
          "$ref": "algites-dependencies_1.yamldef.schema.json#/$defs/Dependencies"
        },
        "DependencyConstraints": {
          "$ref": "algites-dependencies_1.yamldef.schema.json#/$defs/DependencyConstraints"
        },
        "DeleteSnapshotWhenReleased": {
          "type": "boolean",
          "default": true
        },
        "EnvironmentRequirements": {
          "$ref": "algites-environment-requirements_1.yamldef.schema.json"
        },
        "NestedGradleSettingsBuildPolicy": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/NestedGradleSettingsBuildPolicy"
        },
        "native_binary_output": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "native_source_output": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "native_documentation_output": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "modustro_docs_site": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "schema_site": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        }
      },
      "required": [
        "Artifact"
      ]
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": false
}
