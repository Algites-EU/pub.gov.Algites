{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/modustro-source-repository_1.yamldef.schema.json",
  "title": "Modustro Source Repository Definition v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "DocumentContent": {
      "type": "object",
      "properties": {
        "SourceRepository": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Id": {
              "type": "string",
              "minLength": 1
            },
            "Name": {
              "type": "string",
              "minLength": 1
            },
            "Visibility": {
              "type": "string",
              "enum": [
                "pub",
                "priv"
              ]
            },
            "ResourceEndpoints": {
              "$ref": "algites-resource-endpoints_1.yamldef.schema.json#EmbeddedContent"
            }
          },
          "required": [
            "Id"
          ]
        },
        "GroupId": {
          "type": "string",
          "minLength": 1
        },
        "Version": {
          "$ref": "algites-version_1.yamldef.schema.json"
        },
        "CredentialProfiles": {
          "$ref": "algites-credential-profiles_1.yamldef.schema.json#EmbeddedContent"
        },
        "Dependencies": {
          "$ref": "algites-dependencies_1.yamldef.schema.json#/$defs/Dependencies"
        },
        "DependencyConstraints": {
          "$ref": "algites-dependencies_1.yamldef.schema.json#/$defs/DependencyConstraints"
        },
        "DeleteSnapshotWhenReleased": {
          "type": "boolean",
          "default": true
        },
        "EnvironmentRequirements": {
          "$ref": "algites-environment-requirements_1.yamldef.schema.json"
        },
        "NestedGradleSettingsBuildPolicy": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/NestedGradleSettingsBuildPolicy"
        },
        "native_product_binaries": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "native_product_sources": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "native_product_documentation": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "modustro_docs_site": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "schema_site": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "OutputPublishing": {
          "type": "array",
          "items": {
            "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingDeclaration"
          }
        },
        "native_develop_sources": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "native_develop_binaries": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        },
        "native_develop_documentation": {
          "$ref": "modustro-builder-publishing_1.yamldef.schema.json#/$defs/OutputPublishingConfiguration"
        }
      },
      "required": [
        "SourceRepository"
      ]
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": false
}
