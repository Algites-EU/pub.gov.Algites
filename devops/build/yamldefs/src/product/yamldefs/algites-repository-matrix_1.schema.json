{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-repository-matrix_1.schema.json",
  "title": "Algites Publication Repository Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "java": { "$ref": "#/$defs/stabilityMatrix" },
    "python": { "$ref": "#/$defs/stabilityMatrix" },
    "mps": { "$ref": "#/$defs/stabilityMatrix" }
  },
  "$defs": {
    "repositoryUrl": {
      "type": "string",
      "format": "uri",
      "minLength": 1
    },
    "usageMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download": { "$ref": "#/$defs/repositoryUrl" },
        "upload": { "$ref": "#/$defs/repositoryUrl" }
      },
      "minProperties": 1
    },
    "stabilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": { "$ref": "#/$defs/usageMatrix" },
        "snapshot": { "$ref": "#/$defs/usageMatrix" }
      },
      "minProperties": 1
    }
  }
}
