{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-repository-matrix_1.schema.json",
  "title": "Algites Repository Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Java": {
      "$ref": "#/$defs/visibilityMatrix"
    },
    "Python": {
      "$ref": "#/$defs/visibilityMatrix"
    },
    "Mps": {
      "$ref": "#/$defs/visibilityMatrix"
    }
  },
  "$defs": {
    "repositoryEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "pattern": "^algites-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "CredentialProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "Enabled": {
          "type": "boolean"
        },
        "UsageProviderAdapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "Id"
      ],
      "minProperties": 1
    },
    "repositoryEndpointList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryEndpoint"
      }
    },
    "usageMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Download": {
          "$ref": "#/$defs/repositoryEndpointList"
        },
        "Upload": {
          "$ref": "#/$defs/repositoryEndpointList"
        },
        "Manage": {
          "$ref": "#/$defs/repositoryEndpointList"
        }
      },
      "minProperties": 1
    },
    "stabilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Release": {
          "$ref": "#/$defs/usageMatrix"
        },
        "Snapshot": {
          "$ref": "#/$defs/usageMatrix"
        }
      },
      "minProperties": 1
    },
    "visibilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Public": {
          "$ref": "#/$defs/stabilityMatrix"
        },
        "Private": {
          "$ref": "#/$defs/stabilityMatrix"
        }
      },
      "minProperties": 1
    }
  }
}
