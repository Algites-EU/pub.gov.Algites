{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-repository-matrix_1.schema.json",
  "title": "Algites Repository Matrix v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "java": {
      "$ref": "#/$defs/visibilityMatrix"
    },
    "python": {
      "$ref": "#/$defs/visibilityMatrix"
    },
    "mps": {
      "$ref": "#/$defs/visibilityMatrix"
    }
  },
  "$defs": {
    "repositoryEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^algites-[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "credentialProfile": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "enabled": {
          "type": "boolean"
        },
        "usageProviderAdapter": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "id"
      ],
      "minProperties": 1
    },
    "repositoryEndpointList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repositoryEndpoint"
      }
    },
    "usageMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "download": {
          "$ref": "#/$defs/repositoryEndpointList"
        },
        "upload": {
          "$ref": "#/$defs/repositoryEndpointList"
        },
        "manage": {
          "$ref": "#/$defs/repositoryEndpointList"
        }
      },
      "minProperties": 1
    },
    "stabilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "$ref": "#/$defs/usageMatrix"
        },
        "snapshot": {
          "$ref": "#/$defs/usageMatrix"
        }
      },
      "minProperties": 1
    },
    "visibilityMatrix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "public": {
          "$ref": "#/$defs/stabilityMatrix"
        },
        "private": {
          "$ref": "#/$defs/stabilityMatrix"
        }
      },
      "minProperties": 1
    }
  }
}
