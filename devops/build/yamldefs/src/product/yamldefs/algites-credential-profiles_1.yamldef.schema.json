{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-credential-profiles_1.yamldef.schema.json",
  "title": "Algites Credential Profiles v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "credentialProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Type": {
          "type": "string",
          "enum": [
            "basic",
            "bearer",
            "api_key",
            "certificate"
          ]
        },
        "Configuration": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean"
            ]
          }
        }
      },
      "minProperties": 1
    },
    "DocumentContent": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": {
        "$ref": "#/$defs/credentialProfile"
      }
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": {
    "$ref": "#/$defs/credentialProfile"
  }
}
