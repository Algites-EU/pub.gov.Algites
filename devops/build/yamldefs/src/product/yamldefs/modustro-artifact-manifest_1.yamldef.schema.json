{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/modustro-artifact-manifest_1.yamldef.schema.json",
  "title": "Modustro Artifact Manifest v1",
  "x-algites-document-common-metadata": 1,
  "$defs": {
    "DocumentContent": {
      "type": "object",
      "properties": {
        "ManifestVersion": {
          "const": 1
        },
        "Artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "RepositoryId": {
              "type": "string",
              "minLength": 1
            },
            "LocalArtifactId": {
              "type": "string",
              "minLength": 1
            },
            "ArtifactCoordinateId": {
              "type": "string",
              "minLength": 1
            },
            "VariantId": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "GroupId": {
              "type": "string",
              "minLength": 1
            },
            "Version": {
              "type": "string",
              "minLength": 1
            },
            "SourcePath": {
              "type": "string",
              "minLength": 1
            },
            "StructureKind": {
              "type": "string",
              "enum": [
                "artifact_set",
                "artifact"
              ]
            },
            "Name": {
              "type": "string",
              "minLength": 1
            },
            "Description": {
              "type": "string"
            }
          },
          "required": [
            "RepositoryId",
            "LocalArtifactId",
            "ArtifactCoordinateId",
            "Version",
            "SourcePath",
            "StructureKind",
            "Name",
            "Description"
          ]
        },
        "SourceMetadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "DescriptorHierarchy": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "StructureKind": {
                    "type": "string",
                    "enum": [
                      "repository",
                      "artifact_set",
                      "artifact"
                    ]
                  },
                  "Path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "Sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "StructureKind",
                  "Path",
                  "Sha256"
                ]
              }
            }
          },
          "required": [
            "DescriptorHierarchy"
          ]
        }
      },
      "required": [
        "ManifestVersion",
        "Artifact",
        "SourceMetadata"
      ]
    },
    "EmbeddedContent": {
      "$anchor": "EmbeddedContent",
      "allOf": [
        {
          "$ref": "#/$defs/DocumentContent"
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "allOf": [
    {
      "$ref": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/pltf/modustro/builder/common/document-common-metadata_1.yamldef.schema.json"
    },
    {
      "$ref": "#/$defs/DocumentContent"
    }
  ],
  "unevaluatedProperties": false
}
