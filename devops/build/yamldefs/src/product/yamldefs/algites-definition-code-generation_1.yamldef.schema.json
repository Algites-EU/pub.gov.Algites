{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://defs.dev.algites.eu/api/yamldefs/eu/algites/tool/build/yamldefs/algites-definition-code-generation_1.yamldef.schema.json",
  "title": "Algites Definition Code Generation v1",
  "description": "Declares artifact-local canonical definitions that are converted into generated program sources by the standard Algites source_native_processing lifecycle.",
  "$defs": {
    "Item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "SourceKind": {
          "type": "string",
          "enum": [
            "yamldefs",
            "jsondefs",
            "xmldefs"
          ],
          "description": "Definition source family used by the Defs Codegen frontend."
        },
        "Source": {
          "type": "string",
          "minLength": 1,
          "description": "Path to the canonical product definition relative to the artifact directory. The source-root kind must match SourceKind.",
          "pattern": "^src/product/(?:yamldefs|jsondefs|xmldefs)/.+"
        },
        "Targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "java",
              "python"
            ]
          },
          "description": "Program-source TechnologyKinds to generate."
        },
        "Package": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$",
          "description": "Target Java package / Python module namespace."
        },
        "NamingProfile": {
          "type": "string",
          "enum": [
            "algites"
          ],
          "default": "algites",
          "description": "Naming profile applied by Defs Codegen. Phase 5.1A exposes the standard Algites profile."
        }
      },
      "required": [
        "SourceKind",
        "Source",
        "Targets",
        "Package"
      ]
    }
  },
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      },
      "default": []
    }
  },
  "required": [
    "Items"
  ]
}
