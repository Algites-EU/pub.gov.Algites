{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-license-definitions_1.schema.json",
  "title": "Algites License Definitions v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Licenses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "Id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.+-]+$"
          },
          "Name": {
            "type": "string",
            "minLength": 1
          },
          "Url": {
            "type": "string",
            "format": "uri"
          },
          "Text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "Id",
          "Name",
          "Text"
        ]
      }
    }
  },
  "required": [
    "Licenses"
  ]
}
