{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Algites-EU/pub.gov.Algites/main/devops/build/yamldefs/src/product/yamldefs/algites-source-repository_1.schema.json",
  "title": "Algites Source Repository Definition v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "SourceRepository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Name": {
          "type": "string",
          "minLength": 1
        },
        "Visibility": {
          "type": "string",
          "enum": [
            "pub",
            "priv"
          ]
        },
        "Repositories": {
          "$ref": "algites-repository-matrix_1.schema.json"
        }
      },
      "required": [
        "Id"
      ]
    },
    "GroupId": {
      "type": "string",
      "minLength": 1
    },
    "Version": {
      "$ref": "algites-version_1.schema.json"
    },
    "CredentialProfiles": {
      "$ref": "algites-credential-profiles_1.schema.json"
    },
    "DeleteSnapshotWhenReleased": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "SourceRepository"
  ]
}
